<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Thời Khóa Biểu Realtime</title>
    <style>
        :root {
            --primary: #3b82f6;
            --primary-hover: #2563eb;
            --active-bg: #22c55e;
            --active-text: #ffffff;
            --bg: #f8fafc;
            --card-bg: #ffffff;
            --border: #e2e8f0;
            --text: #0f172a;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            padding: 20px;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
        }

        /* Banner hiển thị thời gian & tiết học hiện tại */
        .status-card {
            background: var(--card-bg);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 24px;
            border-left: 6px solid var(--primary);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .status-card.is-active {
            border-left-color: var(--active-bg);
            background: #f0fdf4;
        }

        .clock-display {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary);
        }

        .status-card.is-active .clock-display {
            color: var(--active-bg);
        }

        .task-display {
            font-size: 1.15rem;
            font-weight: 600;
            margin-top: 4px;
        }

        .day-badge {
            background: var(--primary);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 600;
        }

        /* Tabs và Bảng */
        .card {
            background: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin-bottom: 20px;
        }

        .controls {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        button {
            padding: 10px 18px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
        }

        .btn-primary:hover {
            background: var(--primary-hover);
        }

        .btn-secondary {
            background: #e2e8f0;
            color: var(--text);
        }

        .btn-secondary:hover {
            background: #cbd5e1;
        }

        .table-responsive {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: center;
        }

        th, td {
            border: 1px solid var(--border);
            padding: 10px;
            min-width: 100px;
        }

        th {
            background: #f1f5f9;
            font-weight: 600;
        }

        input[type="text"], input[type="time"] {
            width: 100%;
            padding: 6px 8px;
            border: 1px solid var(--border);
            border-radius: 4px;
            text-align: center;
        }

        /* Trạng thái Highlight */
        .is-current-cell {
            background-color: var(--active-bg) !important;
            color: var(--active-text) !important;
            font-weight: bold;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.8; }
            100% { opacity: 1; }
        }

        .section-title {
            margin-bottom: 15px;
            font-size: 1.25rem;
            color: #334155;
        }
    </style>
</head>
<body>

<div class="container">
    <!-- Banner Realtime -->
    <div class="status-card" id="statusCard">
        <div>
            <div class="clock-display" id="clock">00:00:00</div>
            <div class="task-display" id="currentTask">Đang tải dữ liệu...</div>
        </div>
        <div class="day-badge" id="dayOfWeek">Thứ ...</div>
    </div>

    <!-- Bảng xem Timeline & Thời Khóa Biểu -->
    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <h2 class="section-title" style="margin:0;">📅 Thời Khóa Biểu Hiển Thị</h2>
            <button class="btn-primary" onclick="toggleEditMode()" id="editBtn">⚙️ Chỉnh Sửa Lịch</button>
        </div>

        <div class="table-responsive">
            <table id="scheduleTable">
                <thead>
                    <tr>
                        <th>Tiết / Giờ</th>
                        <th>Thứ 2</th>
                        <th>Thứ 3</th>
                        <th>Thứ 4</th>
                        <th>Thứ 5</th>
                        <th>Thứ 6</th>
                    </tr>
                </thead>
                <tbody id="scheduleBody">
                    <!-- Javascript sinh bảng -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Khung Chỉnh Sửa Dữ Liệu (Ẩn/Hiện) -->
    <div class="card" id="editFormCard" style="display: none;">
        <h2 class="section-title">✏️ Cấu Hình Thời Gian & Môn Học</h2>
        <p style="margin-bottom: 15px; color: #64748b; font-size: 0.9rem;">
            Thêm/Xóa tiết học, cấu hình khung giờ và điền môn học. Dữ liệu sẽ tự động lưu vào trình duyệt của bạn.
        </p>
        
        <div class="controls">
            <button class="btn-secondary" onclick="addSlot()">+ Thêm Tiết Học</button>
            <button class="btn-primary" onclick="saveData()">💾 Lưu Lịch Học</button>
        </div>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Tên Tiết</th>
                        <th>Bắt đầu</th>
                        <th>Kết thúc</th>
                        <th>Thứ 2</th>
                        <th>Thứ 3</th>
                        <th>Thứ 4</th>
                        <th>Thứ 5</th>
                        <th>Thứ 6</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody id="editBody">
                    <!-- Dữ liệu form chỉnh sửa -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // 1. Khai báo dữ liệu mặc định
    const defaultTimeSlots = [
        { id: '1', name: 'Tiết 1 (Sáng)', start: '07:30', end: '08:15' },
        { id: '2', name: 'Tiết 2 (Sáng)', start: '08:20', end: '09:05' },
        { id: '3', name: 'Tiết 3 (Sáng)', start: '09:20', end: '10:05' },
        { id: '4', name: 'Tiết 4 (Sáng)', start: '10:10', end: '10:55' },
        { id: '5', name: 'Tiết 1 (Chiều)', start: '13:30', end: '14:15' },
        { id: '6', name: 'Tiết 2 (Chiều)', start: '14:20', end: '15:05' },
        { id: '7', name: 'Tiết 3 (Chiều)', start: '15:20', end: '16:05' }
    ];

    const defaultTimetable = {
        '1': { T2: 'Chào cờ', T3: 'Toán', T4: 'Văn', T5: 'Anh', T6: 'Lý' },
        '2': { T2: 'Toán', T3: 'Toán', T4: 'Văn', T5: 'Anh', T6: 'Lý' },
        '3': { T2: 'Văn', T3: 'Lý', T4: 'Hóa', T5: 'Sinh', T6: 'Sử' },
        '4': { T2: 'Văn', T3: 'Lý', T4: 'Hóa', T5: 'Sinh', T6: 'Địa' },
        '5': { T2: 'Tin học', T3: 'Thể dục', T4: 'Anh phụ', T5: 'Ôn Toán', T6: 'Nghỉ' },
        '6': { T2: 'Tin học', T3: 'Thể dục', T4: 'Anh phụ', T5: 'Ôn Văn', T6: 'Nghỉ' },
        '7': { T2: 'Sinh hoạt', T3: 'Nghỉ', T4: 'Nghỉ', T5: 'Nghỉ', T6: 'Nghỉ' }
    };

    let slots = JSON.parse(localStorage.getItem('timeSlots')) || defaultTimeSlots;
    let timetable = JSON.parse(localStorage.getItem('timetableData')) || defaultTimetable;

    const daysMap = { 1: 'T2', 2: 'T3', 3: 'T4', 4: 'T5', 5: 'T6' };
    const dayNames = { 1: 'Thứ Hai', 2: 'Thứ Ba', 3: 'Thứ Tư', 4: 'Thứ Năm', 5: 'Thứ Sáu', 6: 'Thứ Bảy', 0: 'Chủ Nhật' };

    // 2. Render Bảng hiển thị chính
    function renderDisplayTable() {
        const tbody = document.getElementById('scheduleBody');
        tbody.innerHTML = '';

        slots.forEach(slot => {
            const tr = document.createElement('tr');
            tr.id = `row-${slot.id}`;

            let html = `<td><b>${slot.name}</b><br><small style="color:#64748b">${slot.start} - ${slot.end}</small></td>`;
            for (let i = 2; i <= 6; i++) {
                const dayKey = `T${i}`;
                const subject = timetable[slot.id]?.[dayKey] || '';
                html += `<td id="cell-${slot.id}-${dayKey}">${subject}</td>`;
            }
            tr.innerHTML = html;
            tbody.appendChild(tr);
        });
    }

    // 3. Render Bảng chỉnh sửa dữ liệu
    function renderEditTable() {
        const tbody = document.getElementById('editBody');
        tbody.innerHTML = '';

        slots.forEach((slot, index) => {
            const tr = document.createElement('tr');
            let html = `
                <td><input type="text" value="${slot.name}" onchange="updateSlotMeta(${index}, 'name', this.value)"></td>
                <td><input type="time" value="${slot.start}" onchange="updateSlotMeta(${index}, 'start', this.value)"></td>
                <td><input type="time" value="${slot.end}" onchange="updateSlotMeta(${index}, 'end', this.value)"></td>
            `;

            for (let i = 2; i <= 6; i++) {
                const dayKey = `T${i}`;
                const subject = timetable[slot.id]?.[dayKey] || '';
                html += `<td><input type="text" value="${subject}" onchange="updateSubject('${slot.id}', '${dayKey}', this.value)"></td>`;
            }

            html += `<td><button style="background:#ef4444; color:white; padding: 4px 8px;" onclick="deleteSlot(${index})">Xóa</button></td>`;
            tr.innerHTML = html;
            tbody.appendChild(tr);
        });
    }

    // Cập nhật thông tin Tiết
    function updateSlotMeta(index, key, value) {
        slots[index][key] = value;
    }

    // Cập nhật môn học
    function updateSubject(slotId, dayKey, value) {
        if (!timetable[slotId]) timetable[slotId] = {};
        timetable[slotId][dayKey] = value;
    }

    // Thêm tiết mới
    function addSlot() {
        const newId = Date.now().toString();
        slots.push({ id: newId, name: `Tiết mới`, start: '08:00', end: '08:45' });
        timetable[newId] = { T2: '', T3: '', T4: '', T5: '', T6: '' };
        renderEditTable();
    }

    // Xóa tiết
    function deleteSlot(index) {
        const slotId = slots[index].id;
        slots.splice(index, 1);
        delete timetable[slotId];
        renderEditTable();
    }

    // Lưu dữ liệu vào LocalStorage
    function saveData() {
        localStorage.setItem('timeSlots', JSON.stringify(slots));
        localStorage.setItem('timetableData', JSON.stringify(timetable));
        renderDisplayTable();
        updateTimeline();
        alert('Đã lưu lịch học thành công!');
    }

    // Đổi chế độ chỉnh sửa
    function toggleEditMode() {
        const card = document.getElementById('editFormCard');
        const btn = document.getElementById('editBtn');
        if (card.style.display === 'none') {
            card.style.display = 'block';
            btn.innerText = '✖ Đóng Chỉnh Sửa';
            renderEditTable();
        } else {
            card.style.display = 'none';
            btn.innerText = '⚙️ Chỉnh Sửa Lịch';
        }
    }

    // Convert time string to minutes
    function timeToMinutes(t) {
        if (!t) return 0;
        const [h, m] = t.split(':').map(Number);
        return h * 60 + m;
    }

    // 4. Logic Timeline Realtime
    function updateTimeline() {
        const now = new Date();
        const dayIndex = now.getDay(); 
        const currentMinutes = now.getHours() * 60 + now.getMinutes();

        document.getElementById('clock').innerText = now.toLocaleTimeString('vi-VN');
        document.getElementById('dayOfWeek').innerText = dayNames[dayIndex];

        // Reset highlight
        document.querySelectorAll('.is-current-cell').forEach(el => el.classList.remove('is-current-cell'));
        const card = document.getElementById('statusCard');
        const taskText = document.getElementById('currentTask');

        const currentDayKey = daysMap[dayIndex];

        if (!currentDayKey) {
            card.classList.remove('is-active');
            taskText.innerText = '🏖️ Hôm nay là cuối tuần (Không có lịch học)';
            return;
        }

        // Tìm tiết học đang diễn ra
        let activeSlot = slots.find(s => {
            const start = timeToMinutes(s.start);
            const end = timeToMinutes(s.end);
            return currentMinutes >= start && currentMinutes < end;
        });

        if (activeSlot) {
            card.classList.add('is-active');
            const subject = timetable[activeSlot.id]?.[currentDayKey] || 'Nghỉ/Tự học';
            taskText.innerText = `📖 Đang trong giờ: ${activeSlot.name} (${activeSlot.start} - ${activeSlot.end}) — Môn: ${subject}`;

            // Highlight ô tương ứng
            const cell = document.getElementById(`cell-${activeSlot.id}-${currentDayKey}`);
            if (cell) cell.classList.add('is-current-cell');
        } else {
            card.classList.remove('is-active');
            taskText.innerText = '☕ Hiện tại ngoài giờ học / Giờ ra chơi';
        }
    }

    // Khởi chạy
    renderDisplayTable();
    updateTimeline();
    setInterval(updateTimeline, 1000);
</script>

</body>
</html>
